NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Publieke basis-URL. Alleen nodig voor ontwikkeling of een acceptatieomgeving.
# In productie NIET zetten: de code gebruikt dan https://www.climate-x.nl.
# Een localhost-waarde wordt in productie genegeerd en luid gemeld, zodat een
# uitnodigingsmail nooit met een localhost-link bij een klant kan belanden.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (e-mailverzending bij offerteaanvragen)
# Maak een API-key aan op https://resend.com/api-keys en vul die hieronder in.
RESEND_API_KEY=
# Verzendadres. Het domein climate-x.nl moet geverifieerd zijn in Resend
# (Resend dashboard -> Domains -> DNS-records toevoegen) voordat dit werkt.
RESEND_FROM_EMAIL=ClimateX <offerte@climate-x.nl>
# Adres waarop antwoorden van klanten binnenkomen. Staat los van het
# verzendadres, zodat reacties niet in het offerte-postvak belanden.
# Niet gezet betekent info@climate-x.nl.
RESEND_REPLY_TO_EMAIL=info@climate-x.nl
# E-mailadres waarop jij de interne notificatie ontvangt bij elke nieuwe aanvraag.
# Ook de bestemming van de meldingensamenvatting (/api/meldingen/samenvatting).
ADMIN_NOTIFICATION_EMAIL=ayhan-b@outlook.com

# Service-role key (Supabase dashboard -> Settings -> API -> service_role).
# GEHEIM houden. Nooit met NEXT_PUBLIC_ prefixen; deze sleutel omzeilt RLS volledig.
# Wordt uitsluitend server-side gelezen, in twee route handlers:
#   - app/api/portal/invite/route.ts      klantaccounts en portaaluitnodigingen
#   - app/api/bestanden/verwijder/route.ts  bestanden uit Storage verwijderen
# Die tweede is nodig omdat verwijderen niet langer in de browser met de
# anon-key gebeurt. Die key staat in de JavaScript-bundle en is voor iedereen
# leesbaar; in combinatie met een anon DELETE-policy op de bucket kon daardoor
# elke bezoeker elk bestand wissen. Zonder deze sleutel geeft de verwijderroute
# een 503 en blijft verwijderen onmogelijk in plaats van onbeveiligd.
SUPABASE_SERVICE_ROLE_KEY=
# NIET MEER IN GEBRUIK.
# Was het gedeelde wachtwoord voor het aanmaken van een klantaccount en het
# versturen van een portaaluitnodiging. Die route gebruikt nu de dashboardsessie,
# net als de andere beveiligde routes; de code leest deze variabele nergens meer.
# Hij mag uit de omgeving verdwijnen. Laat hem eventueel nog even staan tot je
# hebt vastgesteld dat het aanmaken van klantaccounts werkt.
PORTAL_ADMIN_SECRET=

# Wachtwoord voor de beheeromgeving op /dashboard. VERPLICHT.
# Wordt uitsluitend server-side gecontroleerd en komt nooit in de browser.
#
# Is deze niet gezet, dan weigert de login iedereen met een 503 die precies
# vertelt wat er ontbreekt. Er is bewust GEEN terugval meer op
# PORTAL_ADMIN_SECRET: die maakte onzichtbaar welk wachtwoord er gold, waardoor
# een login kon falen op een wachtwoord dat volgens de instellingen goed was.
#
# De vergelijking is exact. Een spatie, regeleinde of hoofdletter verschil is
# genoeg om af te keuren, dus let op onzichtbare tekens bij het plakken.
# In Vercel: zet het vinkje Production aan, anders geldt de waarde alleen voor
# previews. Na wijzigen opnieuw deployen.
DASHBOARD_PASSWORD=

# ── CRM-agent ────────────────────────────────────────────────────────
# De agent werkt volledig zonder deze sleutels: hij gebruikt dan sjablonen
# in plaats van een taalmodel. Alle beslissingen over prijzen, prioriteit en
# planning komen sowieso uit expliciete regels en nooit uit een taalmodel.
# Vul dit alleen in als je de tekst van e-mails en WhatsApp-berichten soepeler
# geformuleerd wilt hebben.
#
# AI_PROVIDER=openai        (of: anthropic; leeg laten = sjablonen)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AI_MODEL=                 (optioneel; standaard gpt-4o-mini of claude-sonnet-5)

# Google Calendar: agenda-afspraken automatisch wegschrijven.
# Serviceaccount heeft de voorkeur boven OAuth per gebruiker; de agenda hoort
# bij het bedrijf en er verloopt dan geen token als iemand uit dienst gaat.
# GOOGLE_CALENDAR_ID=
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_KEY=

# Gmail als alternatief voor Resend, als berichten in de verzonden items van
# het bedrijfsaccount moeten staan.
# GMAIL_AFZENDER=

# WhatsApp Business (Meta Cloud API). Let op: buiten een lopend gesprek is een
# door Meta goedgekeurd sjabloon verplicht, en de klant moet aantoonbaar
# toestemming hebben gegeven voor WhatsApp-contact.
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
